# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-your-generated-key
STORAGE_DIR=data
MAX_UPLOAD_MB=100
# Set when the team provides a real local analysis function (no default/mock analysis).
# ANALYZER_CALLABLE=your_cv_package.pipeline:analyze_video
JOB_TIMEOUT_SECONDS=240
# Total budget from HTTP upload request arrival, including upload and queue wait.
TOTAL_JOB_TIMEOUT_SECONDS=300
# Upload reservations + queued + running jobs, shared through SQLite.
MAX_ACTIVE_JOBS=5
MAX_RUNNING_JOBS=1
WORKER_POLL_SECONDS=1

